# MAX API Token - токен бота из https://business.max.ru/self
MAX_ACCESS_TOKEN=your_max_bot_token

# Directus Configuration
DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_TOKEN=your_directus_token

# Group Chat ID in MAX (куда отправлять сообщения)
MAX_CHAT_ID=chat_id_here

# Polling interval in seconds (как часто проверять новые заявки)
POLLING_INTERVAL=10
